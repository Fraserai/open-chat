{
	"name": "open-chat-mobile",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:local": "node server/dev.mjs",
		"backup": "node --env-file-if-exists=.env server/backup.mjs",
		"dev": "vite --host 0.0.0.0",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env server/index.mjs",
		"test": "node --test tests/*.test.mjs",
		"test:browser": "node tests/browser.mjs",
		"test:runtime": "node server/verify-runtime.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prebuild": "cd .. && svelte-kit sync",
		"precheck": "cd .. && svelte-kit sync"
	}
}
